---
import fs from 'node:fs';
import path from 'node:path';
import PostLayout from '../layouts/PostLayout.astro';

const POST_ORDER = [
  { slug: 'mcp-2026-07-28-stateless-spec-explained', title: 'MCP 2026-07-28: The Stateless Spec Rewrite Explained' },
  { slug: 'mcp-tools-vs-resources-vs-prompts', title: "MCP Tools vs Resources vs Prompts: What's the Actual Difference?" },
  { slug: 'context-engineering-explained', title: 'Context Engineering Explained: Why Prompt Engineering Is No Longer Enough' },
  { slug: 'loop-engineering-explained', title: 'Loop Engineering Explained: From Prompt Engineering to Loop Engineering' },
  { slug: 'how-mcp-actually-works', title: 'How MCP Actually Works: How AI Agents Talk to GitHub, Slack & the World' },
  { slug: 'nxm-problem-why-ai-integrations-were-broken-before-mcp', title: 'The N×M Problem: Why AI Integrations Were Broken Before MCP' },
  { slug: 'hermes-v1-vs-v8-react-native', title: 'Hermes V1 vs V8: The JavaScript Engine Deep Dive for React Native 0.84' },
  { slug: 'mcp-vs-adk-whats-the-difference', title: "MCP vs ADK: What's the Difference? | AI Agent Frameworks Explained" },
  { slug: 'metro-bundler-internals', title: 'Metro Bundler Internals: What REALLY Happens When You Run npx react-native start' },
  { slug: 'react-native-new-architecture-2026', title: 'React Native New Architecture 2026: JSI, Fabric, TurboModules & How to Migrate' },
  { slug: 'building-a-react-native-tv-application-with-react-native-tvos', title: 'Building a React Native TV Application' },
  { slug: 'introduction-to-aws-amplify', title: 'Introduction to AWS Amplify' },
  { slug: 'programming-made-easy-with-ruby-enumerables', title: 'Programming made easy with Ruby Enumerables' },
  { slug: 'how-to-start-building-mobile-apps-in-10-mins-with-react-native', title: 'How to start building Mobile apps in 10 mins?' },
];

const BLOG_SLUGS = new Set(POST_ORDER.map(p => p.slug));

export async function getStaticPaths() {
  const publicDir = path.resolve(process.cwd(), 'public');
  const stack = [{ dir: publicDir, relBase: '' }];
  const slugs = [];

  while (stack.length) {
    const { dir, relBase } = stack.pop();
    const entries = fs.readdirSync(dir, { withFileTypes: true });
    for (const entry of entries) {
      const full = path.join(dir, entry.name);
      const rel = relBase ? path.join(relBase, entry.name) : entry.name;
      if (entry.isDirectory()) { stack.push({ dir: full, relBase: rel }); continue; }
      if (entry.isFile() && entry.name === 'index.html') {
        const slug = rel.replace(/\\/g, '/').replace(/\/index\.html$/, '');
        if (slug && slug !== 'index' && slug !== 'index.html' && slug !== '404_not_found' && slug !== '404') {
          slugs.push(slug);
        }
      }
    }
  }
  return slugs.map(slug => ({ params: { slug } }));
}

export const prerender = true;

const slug = typeof Astro.params.slug === 'string' ? Astro.params.slug : '';
const htmlPath = path.resolve(process.cwd(), 'public', slug, 'index.html');
const isBlogPost = BLOG_SLUGS.has(slug);

// --- Raw HTML path (non-blog pages) ---
let rawHtml = '';
if (!isBlogPost) {
  if (slug && slug.includes('.')) {
    rawHtml = '';
  } else if (fs.existsSync(htmlPath)) {
    rawHtml = fs.readFileSync(htmlPath, 'utf8');
  } else {
    const notFoundPath = path.resolve(process.cwd(), 'public', '404.html');
    if (fs.existsSync(notFoundPath)) rawHtml = fs.readFileSync(notFoundPath, 'utf8');
    Astro.response.status = 404;
  }
}

// --- Blog post path ---
let postTitle = '';
let postDate = '';
let postDescription = '';
let postImage = '';
let postContent = '';
let customStyles = '';
let prevPost: { slug: string; title: string } | undefined;
let nextPost: { slug: string; title: string } | undefined;

function decodeEntities(str: string): string {
  return str
    .replace(/&amp;/g, '&')
    .replace(/&ndash;/g, '–')
    .replace(/&mdash;/g, '—')
    .replace(/&nbsp;/g, ' ')
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>');
}

if (isBlogPost && fs.existsSync(htmlPath)) {
  const raw = fs.readFileSync(htmlPath, 'utf8');

  const titleMatch = raw.match(/<title>([^<]+)<\/title>/);
  postTitle = titleMatch
    ? decodeEntities(titleMatch[1]).replace(/\s*[—–\-|]\s*AkshatPaul\.com.*/i, '').trim()
    : slug;

  const dateMatch = raw.match(/article:published_time["'][^>]+content=["']([^"'T]+)/);
  postDate = dateMatch ? dateMatch[1] : '';

  const descMatch =
    raw.match(/property=["']og:description["']\s+content="([^"]*)"/) ||
    raw.match(/property=["']og:description["']\s+content='([^']*)'/);
  postDescription = descMatch ? decodeEntities(descMatch[1]) : '';

  const videoMatch = raw.match(/youtube\.com\/embed\/([a-zA-Z0-9_-]+)/);
  postImage = videoMatch
    ? `https://img.youtube.com/vi/${videoMatch[1]}/maxresdefault.jpg`
    : '/wp-content/uploads/2022/12/react-native-eu-akshat-paul-1-modified.png';

  const styleMatches = [...raw.matchAll(/<style>([\s\S]*?)<\/style>/g)];
  customStyles = styleMatches
    .filter(m => m[1].includes('new-post-'))
    .map(m => m[1])
    .join('\n');

  // Find content inside last elementor-widget-theme-post-content > elementor-widget-container
  const lastWidgetIdx = raw.lastIndexOf('elementor-widget-theme-post-content');
  if (lastWidgetIdx > -1) {
    const containerMarker = '<div class="elementor-widget-container">';
    const containerStart = raw.indexOf(containerMarker, lastWidgetIdx);
    if (containerStart > -1) {
      const contentStart = containerStart + containerMarker.length;
      let depth = 1;
      let pos = contentStart;
      while (pos < raw.length && depth > 0) {
        const o = raw.indexOf('<div', pos);
        const c = raw.indexOf('</div>', pos);
        if (c === -1) break;
        if (o !== -1 && o < c) { depth++; pos = o + 4; }
        else { depth--; if (depth === 0) { postContent = raw.slice(contentStart, c); break; } pos = c + 6; }
      }
    }
  }

  if (!postContent) {
    const bodyMatch = raw.match(/<body[^>]*>([\s\S]*)<\/body>/i);
    if (bodyMatch) postContent = bodyMatch[1].trim();
  }

  const postIndex = POST_ORDER.findIndex(p => p.slug === slug);
  prevPost = postIndex + 1 < POST_ORDER.length ? POST_ORDER[postIndex + 1] : undefined;
  nextPost = postIndex - 1 >= 0 ? POST_ORDER[postIndex - 1] : undefined;
}
---

{isBlogPost ? (
  <PostLayout title={postTitle} date={postDate} description={postDescription} image={postImage} url={`https://akshatpaul.com/${slug}/`} customStyles={customStyles} prevPost={prevPost} nextPost={nextPost}>
    <Fragment set:html={postContent} />
  </PostLayout>
) : (
  <Fragment set:html={rawHtml} />
)}
