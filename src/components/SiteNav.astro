---
const links = [
  { href: '/', label: 'Home' },
  { href: '/#about', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/#publications', label: 'Publications' },
  { href: '/#talks', label: 'Talks/Interviews' },
  { href: 'https://github.com/akshatpaul', label: 'GitHub', external: true },
  { href: 'https://twitter.com/paulakshat', label: 'Twitter', external: true },
];

const currentPath = Astro.url.pathname;
---

<nav class="site-nav">
  <div class="nav-inner">
    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <ul class="nav-links">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class={currentPath === link.href ? 'active' : ''}
            {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
          >{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
.site-nav {
  background: #0d0d0d;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid #222;
}
.nav-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 1.5rem;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 2rem;
  height: 64px;
}
.nav-links {
  display: flex;
  list-style: none;
  gap: 0.25rem;
  flex-wrap: wrap;
}
.nav-links a {
  font-family: var(--font-heading);
  font-size: 0.875rem;
  font-weight: 500;
  color: #ccc;
  padding: 0.4rem 0.75rem;
  border-radius: 4px;
  transition: color 0.15s, background 0.15s;
}
.nav-links a:hover,
.nav-links a.active { color: #fff; background: var(--color-primary); }
.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
}
.nav-toggle span {
  display: block;
  width: 24px;
  height: 2px;
  background: #ccc;
  border-radius: 2px;
  transition: background 0.15s;
}
.nav-toggle:hover span { background: #fff; }

@media (max-width: 768px) {
  .nav-toggle { display: flex; }
  .nav-links {
    display: none;
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    background: #0d0d0d;
    flex-direction: column;
    padding: 1rem 1.5rem 1.5rem;
    border-top: 1px solid #222;
    gap: 0;
  }
  .nav-links.open { display: flex; }
  .nav-links a { padding: 0.6rem 0.75rem; font-size: 1rem; }
}
</style>

<script>
const toggle = document.querySelector('.nav-toggle');
const links = document.querySelector('.nav-links');
toggle?.addEventListener('click', () => {
  const open = links?.classList.toggle('open');
  toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
});
</script>
